# HowToHack - Environment Configuration
# =======================================
# This file contains environment variable templates.
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Application
APP_NAME=HowToHack
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

# Database (SQLite for development)
DB_CONNECTION=sqlite
# DB_DATABASE=

# For PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=howtohack
# DB_USERNAME=postgres
# DB_PASSWORD=

# Queue & Cache (Redis recommended)
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration
# At least one provider API key is required for AI-powered features.
# If no key is set, the system falls back to deterministic scanning.
AI_AGENT_PROVIDER=openrouter

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4

# Claude (Anthropic)
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-opus-20240229

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_FAST_MODEL=qwen/qwen3-coder
# OPENROUTER_ANALYSIS_MODEL=deepseek/deepseek-chat-v3
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Agent Behavior
# AI_MAX_REASONING=100
# AI_AUTO_STOP_THRESHOLD=0.85

# Scanner Configuration
SCANNER_TIMEOUT=30
SCANNER_MAX_CONCURRENT=5
SCANNER_RETRY_ATTEMPTS=3
# SCANNER_RETRY_DELAY=1000
# SCANNER_DIR_WORDLIST=

# Docker Scanner Configuration
# SCANNER_DOCKER_IMAGE=howtohack/scanner:latest
# SCANNER_DOCKER_NETWORK=host
# SCANNER_DOCKER_MEMORY=512m
# SCANNER_DOCKER_TIMEOUT=120

# Vite
# VITE_APP_NAME="${APP_NAME}"
