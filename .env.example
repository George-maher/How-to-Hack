# HowToHack — environment template
# ================================
# Copy to `.env` and fill in the values. The compose stack refuses to start
# without DB_PASSWORD, REDIS_PASSWORD and RUNNER_SECRET.
#
# NEVER commit `.env`.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=HowToHack
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

# Anonymous account creation. Leave false on any internet-reachable instance:
# this tool scans networks, so accounts are an operator decision.
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------
# Database (compose service name, not localhost)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=howtohack
DB_USERNAME=howtohack
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache / queue
# ---------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Must exceed the longest job timeout (RunScanJob: 90s) or a running scan can be
# delivered to a second worker.
REDIS_QUEUE_RETRY_AFTER=120

# ---------------------------------------------------------------------------
# Target policy — deny by default
# ---------------------------------------------------------------------------
# Comma-separated hosts this instance may scan. Nothing else is reachable.
SCAN_ALLOWLIST=
# Narrow, expiring local exceptions, e.g.
# [{"host":"127.0.0.1","ports":[8080],"expires_at":"2026-12-31T00:00:00Z","note":"local lab"}]
SCAN_LAB_EXCEPTIONS=[]

# ---------------------------------------------------------------------------
# Approvals and execution bounds
# ---------------------------------------------------------------------------
SCAN_APPROVAL_TTL_MINUTES=120
SCAN_APPROVAL_REQUEST_TTL_MINUTES=1440
SCAN_MAX_DURATION=900
SCAN_HEARTBEAT_STALE_SECONDS=300
SCANNER_TIMEOUT=120
# Refuse targets that resolve to more addresses than this (split-answer guard).
SCAN_MAX_RESOLVED_ADDRESSES=8
SCAN_MAX_SCANNERS=10

# ---------------------------------------------------------------------------
# Runner (isolated scanner execution)
# ---------------------------------------------------------------------------
RUNNER_URL=http://runner:8080
# 32+ characters. Generate with: openssl rand -hex 32
RUNNER_SECRET=
# Set false to run without Docker-backed scanners. Scans then report those
# scanners as `unavailable` instead of silently returning no findings.
RUNNER_ENABLED=true
RUNNER_HTTP_TIMEOUT=60
RUNNER_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# AI provider (optional; scanning falls back to a deterministic planner)
# ---------------------------------------------------------------------------
# One of: openrouter | openai | claude. Provider choice is by name; each
# provider has its own model and key (there is no shared model variable).
AI_AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
# The Claude provider reads CLAUDE_API_KEY, not ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-opus-20240229

# ---------------------------------------------------------------------------
# Frontend (browser-facing!)
# ---------------------------------------------------------------------------
# Must be the URL the *browser* can reach, not a container hostname.
VITE_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
# Leave empty to keep audit events forever. Only set this if you are permitted
# to delete security evidence.
AUDIT_RETENTION_DAYS=
