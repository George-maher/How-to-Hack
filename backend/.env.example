APP_NAME=HowToHack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=howtohack
DB_USERNAME=howtohack
DB_PASSWORD=changeme_in_production

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Security (Phase 1)
# ---------------------------------------------------------------------------
# Anonymous registration is off by default.
ALLOW_REGISTRATION=false

# Deny-by-default target policy. Nothing is scannable until it is listed here.
SCAN_ALLOWLIST=
# Narrow, expiring local exceptions (JSON). One host each, explicit ports.
SCAN_LAB_EXCEPTIONS=[]

# Approval window for active scans.
SCAN_APPROVAL_TTL_MINUTES=120
SCAN_APPROVAL_REQUEST_TTL_MINUTES=1440

# Execution bounds (the reaper uses the heartbeat threshold).
SCAN_MAX_DURATION=900
SCAN_HEARTBEAT_STALE_SECONDS=300
SCANNER_TIMEOUT=120

# Runner service. RUNNER_SECRET must be 32+ characters; the Runner refuses to
# start otherwise, and jobs are refused without it.
RUNNER_URL=http://runner:8080
RUNNER_SECRET=

# Must exceed RunScanJob's 90s timeout.
REDIS_QUEUE_RETRY_AFTER=120
